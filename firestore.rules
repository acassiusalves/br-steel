rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A autenticação principal do app ainda não emite Firebase Auth tokens.
    // Por isso, as coleções legadas abaixo continuam abertas temporariamente
    // até serem migradas para APIs server-side. O catch-all global foi removido
    // para impedir exposição acidental de novas coleções sensíveis.
    function legacyClientAccess() {
      return true;
    }

    // Conversas e credenciais do Mercado Livre devem ser acessadas apenas por
    // API routes/server actions com Admin SDK.
    match /mercadoLivreConversations/{document=**} {
      allow read, write: if false;
    }

    match /mercadoLivreAccounts/{document=**} {
      allow read, write: if false;
    }

    // Identidade e permissões: somente backend autenticado com Admin SDK.
    match /users/{document=**} {
      allow read, write: if false;
    }

    match /appSettings/{document=**} {
      allow read, write: if false;
    }

    // OAuth identities, intents and grants are accessible only through authenticated backend services.
    match /mcpIdentities/{document=**} {
      allow read, write: if false;
    }

    match /mcpIdentityBindings/{document=**} {
      allow read, write: if false;
    }

    match /mcpConnections/{document=**} {
      allow read, write: if false;
    }

    match /mcpAuthorizationIntents/{document=**} {
      allow read, write: if false;
    }

    // Chaves do corte (operationalSource, coreWriteMode), credenciais de integrações e estados OAuth.
    // Nenhum código do navegador lê appConfig: todo acesso passa pelo Admin SDK no servidor.
    match /appConfig/{document=**} {
      allow read, write: if false;
    }

    // Índices internos e sequência transacional: somente Admin SDK.
    match /supplyCodes/{document=**} { allow read, write: if false; }
    match /operationsMetadata/{document=**} { allow read, write: if false; }

    match /supplies/{document=**} {
      allow read, write: if false;
    }

    match /inventoryMovements/{document=**} {
      allow read, write: if false;
    }

    match /salesOrders/{document=**} {
      allow read, write: if false;
    }

    // Conciliação financeira: acessada exclusivamente pela API route
    // /api/financeiro/conciliacao com Admin SDK (server-side). O client
    // nunca lê/escreve essas coleções diretamente.
    match /conciliationSales/{document=**} {
      allow read, write: if false;
    }

    match /conciliationMarketplacePayouts/{document=**} {
      allow read, write: if false;
    }

    match /conciliationSettings/{document=**} {
      allow read, write: if false;
    }

    match /conciliationImportFiles/{document=**} {
      allow read, write: if false;
    }

    match /conciliationAssociations/{document=**} {
      allow read, write: if false;
    }

    match /conciliationCategories/{document=**} {
      allow read, write: if false;
    }

    match /conciliationTemplates/{document=**} {
      allow read, write: if false;
    }

    match /productionColumns/{document=**} {
      allow read, write: if false;
    }

    match /productionLots/{document=**} {
      allow read, write: if false;
    }

    match /productionLotItems/{document=**} {
      allow read, write: if false;
    }

    match /productionComments/{document=**} {
      allow read, write: if false;
    }

    // Sem chamadores no código (src/services/ml-firestore.ts).
    match /feed_entries/{document=**} {
      allow read, write: if false;
    }

    match /product_match_training/{document=**} {
      allow read, write: if false;
    }

    // Ainda lido e gravado pelo SDK cliente (curva ABC); fecha quando o acesso for para o servidor.
    match /productGroups/{document=**} {
      allow read, write: if legacyClientAccess();
    }

    match /stockUpdates/{document=**} {
      allow read, write: if false;
    }

    match /webhookDebugLogs/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
